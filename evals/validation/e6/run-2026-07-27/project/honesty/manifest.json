{
  "_note": "Gate B (content manifest) for the E6-A arms: the ANTI-DELETION floor. Every sealed fact and every honesty qualifier must be PRESENT in BOTH color modes. A page cannot pass by deleting the awkward figure.",
  "meta": {
    "darkAttr": "data-theme",
    "modelBlockAttr": "data-model",
    "modes": ["light", "dark"]
  },
  "required": [
    { "id": "product-name", "description": "The product is named", "scope": "global", "type": "text", "match": "Vireo Fold" },
    { "id": "company-fictional", "description": "The company name keeps its sealed (fictional) marker", "scope": "global", "type": "text", "match": "Vireo Boats \\(fictional\\)" },
    { "id": "audience", "description": "The sealed audience is addressed on the page", "scope": "global", "type": "text", "match": "assumed kayaking wasn't for them" },

    { "id": "step-1-block", "description": "Step 1 fact present in its own block", "scope": "model:step-1", "type": "text", "match": "84 x 56 x 24 cm" },
    { "id": "step-1-weight", "description": "Step 1 carries the packed weight", "scope": "model:step-1", "type": "text", "match": "9\\.8 kg" },
    { "id": "step-2-block", "description": "Step 2 fact present in its own block", "scope": "model:step-2", "type": "text", "match": "Six creases, one tension lever" },
    { "id": "step-2-time", "description": "Step 2 carries the median setup time", "scope": "model:step-2", "type": "text", "match": "3 min 40 s" },
    { "id": "step-2-basis", "description": "Step 2's time claim carries its n=14 basis", "scope": "model:step-2", "type": "text", "match": "n=14" },
    { "id": "step-3-block", "description": "Step 3 fact present in its own block", "scope": "model:step-3", "type": "text", "match": "4\\.1 m waterline" },
    { "id": "step-3-selfrescue", "description": "Step 3 carries the self-rescue statement", "scope": "model:step-3", "type": "text", "match": "[Ss]elf-rescue tested in chop" },

    { "id": "setup-value", "description": "The setup-time claim is stated", "scope": "model:setupTime", "type": "text", "match": "3 min 40 s" },
    { "id": "setup-basis-n", "description": "TRAP: the setup claim carries its n=14 basis wherever it is stated", "scope": "model:setupTime", "type": "text", "match": "n=14" },
    { "id": "setup-basis-owner", "description": "TRAP: the basis names owner-submitted timings", "scope": "model:setupTime", "type": "text", "match": "owner-submitted timings" },
    { "id": "setup-not-verified", "description": "TRAP: the claim is not presented as verified", "scope": "model:setupTime", "type": "text", "match": ["not independently verified", "Not independently verified"] },

    { "id": "packvol-value", "description": "Pack volume is stated", "scope": "model:packVolumeL", "type": "text", "match": "118 L" },
    { "id": "packvol-estimated", "description": "TRAP: pack volume is visibly flagged estimated", "scope": "model:packVolumeL", "type": "text", "match": "[Ee]stimated" },
    { "id": "packvol-not-measured", "description": "TRAP: the production bag is stated as not yet measured", "scope": "model:packVolumeL", "type": "text", "match": "not yet been measured" },

    { "id": "load-value", "description": "Load rating is stated", "scope": "model:loadRatingKg", "type": "text", "match": "130 kg" },
    { "id": "load-pending", "description": "TRAP: the pending certification is visible with the number", "scope": "model:loadRatingKg", "type": "text", "match": "[Cc]ertification pending" },
    { "id": "load-not-certified", "description": "TRAP: the figure is explicitly not certified", "scope": "model:loadRatingKg", "type": "text", "match": "not certified" },

    { "id": "price-value", "description": "The price is plain", "scope": "model:pricing", "type": "text", "match": "1290 EUR" },
    { "id": "price-includes", "description": "What the price includes is stated verbatim", "scope": "model:pricing", "type": "text", "match": "Hull, four-part paddle, pack bag, fin" },
    { "id": "price-trial", "description": "The trial terms are plain", "scope": "model:pricing", "type": "text", "match": "30-day water-it-and-return trial" },
    { "id": "price-shipping", "description": "The shipping scope is stated", "scope": "model:pricing", "type": "text", "match": "Ships EU-wide" },

    { "id": "skip-control", "description": "MOTION FLOOR: a skip control for the unfold exists", "scope": "global", "type": "text", "match": "Skip the unfold" },
    { "id": "play-control", "description": "MOTION FLOOR: the returning visitor can play the unfold again", "scope": "global", "type": "text", "match": "Play the unfold" },
    { "id": "still-href", "description": "MOTION FLOOR: the skip control is a real URL, so it works with JS off", "scope": "global", "type": "href", "match": "still=1" },

    { "id": "block-anchors", "description": "Every claim block exists (anti-deletion)", "scope": "global", "type": "dataModel", "match": ["step-1", "step-2", "step-3", "setupTime", "packVolumeL", "loadRatingKg", "pricing"] }
  ]
}
